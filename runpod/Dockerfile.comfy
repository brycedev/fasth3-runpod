# RunPod Comfy turbo image (larryvrh v4 @ 8 + Sage + SLA).
# Pins match app.py ComfyWorker. Weights live on a network volume — do not
# bake ~43 GB of INT8 DiT / NVFP4 CLIP / VAEs / v4 LoRA into this image.
# Skip RTX VSR / NGX (not needed for the T2VA bench).

FROM nvidia/cuda:13.0.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    UV_TORCH_BACKEND=cu130 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/h3 \
    HF_HOME=/runpod-volume/hf \
    GIT_TERMINAL_PROMPT=0

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ffmpeg curl python3 python3-pip python3-venv python3-dev \
      ca-certificates openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && ln -sf /usr/bin/python3 /usr/local/bin/python3.12

RUN python3 -m pip install --break-system-packages --no-cache-dir uv

# ComfyUI pin: app.py comfy_image (b78cec879b94).
# rm -rf first: kaniko retries of a failed RUN leave /comfyui behind.
RUN rm -rf /comfyui \
    && git clone https://github.com/Comfy-Org/ComfyUI /comfyui \
    && git -C /comfyui checkout b78cec879b94 \
    && python3 -m uv pip install --system --break-system-packages \
         -r /comfyui/requirements.txt sageattention httpx pillow

# Custom nodes: same SHAs as app.py. PlagueKind pack is pruned to SLA only.
RUN rm -rf /comfyui/custom_nodes/ComfyUI-MiniMax-H3-Turbo \
    && git clone https://github.com/Larryvrh/ComfyUI-MiniMax-H3-Turbo \
      /comfyui/custom_nodes/ComfyUI-MiniMax-H3-Turbo \
    && git -C /comfyui/custom_nodes/ComfyUI-MiniMax-H3-Turbo checkout 4274783a23af \
    && git clone https://github.com/kijai/ComfyUI-SolAttn_triton \
      /comfyui/custom_nodes/ComfyUI-SolAttn_triton \
    && git -C /comfyui/custom_nodes/ComfyUI-SolAttn_triton checkout dfc2e31a41af \
    && git clone https://github.com/xmarre/ComfyUI-Spectrum-MiniMax-H3 \
      /comfyui/custom_nodes/ComfyUI-Spectrum-MiniMax-H3 \
    && git -C /comfyui/custom_nodes/ComfyUI-Spectrum-MiniMax-H3 checkout 9dc51b7fbb6e \
    && git clone https://github.com/PlagueKind/ComfyUI-PlagueKind-Nodes \
      /comfyui/custom_nodes/ComfyUI-PlagueKind-Nodes \
    && git -C /comfyui/custom_nodes/ComfyUI-PlagueKind-Nodes checkout b8d456ccea03 \
    && rm -rf /comfyui/custom_nodes/ComfyUI-PlagueKind-Nodes/{bbox_crop,crop_and_resize,ltx_lora_loader,unified_resize,bundle_nodes,ComfyUI-H3-AdaLN-LoRA-Fix} \
    && git clone https://github.com/kijai/ComfyUI-KJNodes \
      /comfyui/custom_nodes/ComfyUI-KJNodes \
    && git -C /comfyui/custom_nodes/ComfyUI-KJNodes checkout 3f20054214fe \
    && python3 -m uv pip install --system --break-system-packages \
         -r /comfyui/custom_nodes/ComfyUI-KJNodes/requirements.txt \
    && python3 -m uv pip install --system --break-system-packages \
         diffusers einops kornia 'ninja~=1.11.1.4' 'transformers[timm]>=4.50.0' \
    && git clone https://github.com/scottmudge/ComfyUI_MinimaxH3HybridLoader \
      /comfyui/custom_nodes/ComfyUI_MinimaxH3HybridLoader \
    && git -C /comfyui/custom_nodes/ComfyUI_MinimaxH3HybridLoader checkout a44c69b02242

COPY turbo_patch.py /opt/h3/turbo_patch.py
RUN python3 /opt/h3/turbo_patch.py

COPY runpod/entrypoint_comfy.sh /opt/h3/entrypoint.sh
COPY runpod/comfy_worker.py /opt/h3/comfy_worker.py
RUN chmod +x /opt/h3/entrypoint.sh

EXPOSE 8188 8000 22
WORKDIR /comfyui
ENTRYPOINT ["/opt/h3/entrypoint.sh"]
